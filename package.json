{
  "name": "prectxe",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "gate": "bun --cwd apps/gate run start",
    "gate:type-check": "bun --cwd apps/gate run type-check",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "[ -z \"$CI\" ] && husky || echo Skip husky in CI"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.11.6"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  }
}
