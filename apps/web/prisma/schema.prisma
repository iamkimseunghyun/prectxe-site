generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Program {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  summary     String?
  description String?
  type        ProgramType
  status      ProgramStatus   @default(completed)
  startAt     DateTime
  endAt       DateTime?
  city        String?
  heroUrl     String?
  venue       String?
  organizer   String?
  userId      String
  venueId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  isFeatured  Boolean         @default(false)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueLink   Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  credits     ProgramCredit[]
  images      ProgramImage[]
  articles    Article[]

  @@index([isFeatured, updatedAt])
}

model ProgramImage {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  programId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model ProgramCredit {
  programId String
  artistId  String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([programId, artistId])
  @@index([artistId])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  cover       String?
  tags        String[]
  publishedAt DateTime?
  authorId    String?
  programId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isFeatured  Boolean   @default(false)
  views       Int       @default(0)
  author      User?     @relation(fields: [authorId], references: [id])
  program     Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([isFeatured, updatedAt])
  @@index([publishedAt])
  @@index([programId])
}

model User {
  id             String          @id @default(cuid())
  username       String?         @unique
  email          String?         @unique
  password       String?
  createdAt      DateTime?       @default(now())
  role           Role?           @default(USER)
  updatedAt      DateTime?       @updatedAt
  articles       Article[]
  artists        Artist[]
  artworks       Artwork[]
  forms          Form[]
  programs       Program[]
  venues         Venue[]
  smsCampaigns   SMSCampaign[]
  emailCampaigns EmailCampaign[]
}

model Artist {
  id             String          @id @default(cuid())
  mainImageUrl   String?
  city           String?
  country        String?
  email          String?
  homepage       String?
  instagram      String?
  soundcloud     String?
  bandcamp       String?
  youtube        String?
  spotify        String?
  tagline        String?
  tags           String[]        @default([])
  biography      String?
  cv             String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  name           String          @map("name_en")
  nameKr         String          @map("name_kr")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistArtworks ArtistArtwork[]
  images         ArtistImage[]
  programCredits ProgramCredit[]
  dropCredits    DropCredit[]

  // Prisma는 FK에 인덱스를 자동 생성하지 않는다. 다른 모델은 FK 인덱스
  // 스윕(2026-06-19)에 포함됐는데 Artist.userId만 누락돼 있었다.
  @@index([userId])
  // 공개 목록의 기본 정렬(createdAt desc, id desc)
  @@index([createdAt, id])
}

model ArtistImage {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  artistId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

model Artwork {
  id          String          @id @default(cuid())
  title       String
  size        String?
  media       String?
  year        Int?
  description String?
  style       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  artists     ArtistArtwork[]
  user        User            @relation(fields: [userId], references: [id])
  images      ArtworkImage[]
}

model ArtworkImage {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  artworkId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
}

model Venue {
  id          String       @id @default(cuid())
  name        String
  tagline     String?
  description String?
  address     String?
  city        String?
  country     String?
  website     String?
  instagram   String?
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  images      VenueImage[]
  programs    Program[]
  drops       Drop[]
}

model VenueImage {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  venueId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ArtistArtwork {
  artistId  String
  artworkId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@id([artistId, artworkId])
  @@index([artworkId])
}

enum ProgramType {
  exhibition
  live
  party
  workshop
  talk
}

enum ProgramStatus {
  draft
  upcoming // deprecated: Program은 아카이브(completed) 전용. 값은 레거시 데이터 호환용 dormant.
  completed
}

enum Role {
  ADMIN
  USER
}

model Form {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  description    String?
  body           String?          @db.Text
  coverImage     String?
  status         FormStatus       @default(draft)
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields         FormField[]
  submissions    FormSubmission[]
  smsCampaigns   SMSCampaign[]
  emailCampaigns EmailCampaign[]
}

model FormField {
  id          String         @id @default(cuid())
  formId      String
  type        FieldType
  label       String
  placeholder String?
  helpText    String?
  required    Boolean        @default(false)
  options     String[]
  order       Int            @default(0)
  validation  Json?
  archived    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  form        Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses   FormResponse[]

  @@index([formId])
}

model FormSubmission {
  id          String         @id @default(cuid())
  formId      String
  submittedAt DateTime       @default(now())
  ipAddress   String?
  userAgent   String?
  form        Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses   FormResponse[]

  @@index([formId, submittedAt])
}

model FormResponse {
  id           String         @id @default(cuid())
  submissionId String
  fieldId      String?
  fieldLabel   String?
  fieldType    FieldType?
  value        String
  createdAt    DateTime       @default(now())
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        FormField?     @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([fieldId])
}

enum FormStatus {
  draft
  published
  closed
}

enum FieldType {
  text
  textarea
  select
  multiselect
  radio
  checkbox
  date
  email
  phone
  url
  file
  number
}

model SMSCampaign {
  id          String         @id @default(cuid())
  title       String
  message     String         @db.Text
  formId      String?
  userId      String
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  status      SMSStatus      @default(draft)
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  form        Form?          @relation(fields: [formId], references: [id], onDelete: SetNull)
  recipients  SMSRecipient[]
}

model SMSRecipient {
  id         String      @id @default(cuid())
  campaignId String
  phone      String
  name       String?
  value      String?
  success    Boolean     @default(false)
  messageId  String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  campaign   SMSCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

enum SMSStatus {
  draft
  sending
  sent
  failed
}

model EmailCampaign {
  id          String           @id @default(cuid())
  title       String
  subject     String
  body        String           @db.Text
  template    String?
  formId      String?
  userId      String
  sentCount   Int              @default(0)
  failedCount Int              @default(0)
  status      EmailStatus      @default(draft)
  sentAt      DateTime?
  broadcastId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  form        Form?            @relation(fields: [formId], references: [id], onDelete: SetNull)
  recipients  EmailRecipient[]

  // Prisma는 FK에 인덱스를 자동 생성하지 않는다. 2026-06-19 FK 인덱스 일괄
  // 추가 때 이 모델만 누락돼 있었다. sentAt은 통계(최근 12개월 조회) 기준.
  @@index([userId])
  @@index([formId])
  @@index([sentAt])
}

model EmailRecipient {
  id         String        @id @default(cuid())
  campaignId String
  email      String
  success    Boolean       @default(false)
  messageId  String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

enum EmailStatus {
  draft
  sending
  sent
  failed
}

// ─── Drops & Commerce ─────────────────────────────────

model Drop {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  summary      String?
  description  String?
  type         DropType
  eventDate    DateTime?
  eventEndDate DateTime?
  venue        String?
  venueAddress String?
  venueId      String?
  notice       String?
  isFeatured   Boolean        @default(false)
  /// 이미 입장한 티켓을 다시 스캔했을 때 들여보낼지 (전시·레이브 등)
  allowReentry Boolean        @default(false)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  venueLink    Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  media        DropMedia[]
  credits      DropCredit[]
  ticketTiers  TicketTier[]
  variants     GoodsVariant[]
  orders       Order[]
  checkIns     CheckIn[]
  staff        DropStaff[]

  @@index([isFeatured, updatedAt])
  @@index([publishedAt])
}

model DropCredit {
  dropId    String
  artistId  String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@id([dropId, artistId])
  @@index([artistId])
}

model DropMedia {
  id        String        @id @default(cuid())
  dropId    String
  drop      Drop          @relation(fields: [dropId], references: [id], onDelete: Cascade)
  type      DropMediaType
  url       String // 이미지: Cloudflare Images URL / 영상: Cloudflare Stream ID
  alt       String        @default("")
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([dropId])
}

model TicketTier {
  id          String      @id @default(cuid())
  dropId      String?
  name        String
  description String?
  price       Int // 원 단위
  quantity    Int // 총 수량
  soldCount   Int         @default(0)
  maxPerOrder Int         @default(4)
  saleStart   DateTime?
  saleEnd     DateTime?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  drop        Drop?       @relation(fields: [dropId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  tickets     Ticket[]

  @@index([dropId])
}

model GoodsVariant {
  id         String      @id @default(cuid())
  dropId     String
  name       String
  price      Int
  stock      Int         @default(0)
  soldCount  Int         @default(0)
  options    Json? // { size?: string, color?: string, ... }
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  drop       Drop        @relation(fields: [dropId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([dropId])
}

model Order {
  id           String        @id @default(cuid())
  orderNo      String        @unique
  accessToken  String?       @unique
  dropId       String?
  buyerName    String
  buyerEmail   String
  buyerPhone   String
  totalAmount  Int
  status       OrderStatus   @default(pending)
  locale       String        @default("ko")
  /// 어드민이 발급한 게스트 입장(0원, 결제 없음, 등급 없음). 매출·주문 목록·
  /// 내보내기 같은 판매 집계에서는 반드시 뺀다 (`isGuest: false`)
  isGuest      Boolean       @default(false)
  /// 게스트 메모 (누구의 게스트인지 등). 입구 확인용으로 게이트 앱에도 내려간다
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  drop         Drop?         @relation(fields: [dropId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  payment      Payment?
  bankTransfer BankTransfer?
  tickets      Ticket[]

  @@index([dropId])
  @@index([status, createdAt])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  ticketTierId   String?
  goodsVariantId String?
  quantity       Int
  unitPrice      Int
  subtotal       Int
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier     TicketTier?   @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  goodsVariant   GoodsVariant? @relation(fields: [goodsVariantId], references: [id], onDelete: SetNull)
  tickets        Ticket[]

  @@index([orderId])
  @@index([ticketTierId])
  @@index([goodsVariantId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  portonePaymentId String        @unique
  method           String?
  amount           Int
  status           PaymentStatus @default(pending)
  paidAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  rawData          Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model BankTransfer {
  id            String             @id @default(cuid())
  orderId       String             @unique
  depositorName String
  amount        Int
  expiresAt     DateTime
  status        BankTransferStatus @default(pending)
  confirmedAt   DateTime?
  confirmedBy   String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model Ticket {
  id           String       @id @default(cuid())
  token        String       @unique
  orderId      String
  orderItemId  String
  ticketTierId String?
  status       TicketStatus @default(active)
  checkedInAt  DateTime?
  checkedInBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier?  @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  checkIns     CheckIn[]

  @@index([status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([ticketTierId])
}

/// 입장·입장 취소 기록. 지우지 않고 쌓는다 — Ticket.status/checkedInAt은 현재 상태 캐시다.
/// "누가 언제 어느 입구에서"를 복원하고, 오프라인 기록이 겹쳤을 때 사후 추적하는 근거.
model CheckIn {
  id        String       @id @default(cuid())
  /// 기록을 만든 쪽(기기·서버)이 붙이는 UUID. 재전송돼도 한 번만 저장된다
  clientId  String       @unique
  kind      CheckInKind
  ticketId  String
  dropId    String
  /// 입구 이름 (A, B 등). 웹 스캐너는 비워 둔다
  gate      String?
  /// 웹 스캐너에서 처리한 어드민 User.id
  userId    String?
  /// 게이트 앱에서 처리한 스태프
  staffId   String?
  /// 스캔한 시각 (기기 기준). 서버 수신 시각은 createdAt
  scannedAt DateTime
  /// 오프라인 기록을 동기화했을 때 문제가 있던 입장. 정상이면 null
  flag      CheckInFlag?
  /// 취소 기록이 되돌린 입장의 clientId (게이트 앱의 취소만). 표시된 입장이
  /// 이미 취소로 무효가 됐는지 화면에서 가려내는 데 쓴다
  undoes    String?
  createdAt DateTime     @default(now())
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  drop      Drop         @relation(fields: [dropId], references: [id], onDelete: Cascade)
  staff     Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([dropId, createdAt])
  @@index([staffId])
}

/// 게이트 앱으로 입장을 처리하는 현장 스태프. 비밀번호 없이 이메일로 받은
/// 일회용 코드로 로그인한다. 어떤 행사를 볼 수 있는지는 DropStaff가 정한다.
model Staff {
  id         String           @id @default(cuid())
  /// 소문자로 정규화해 저장한다
  email      String           @unique
  name       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  drops      DropStaff[]
  loginCodes StaffLoginCode[]
  sessions   StaffSession[]
  checkIns   CheckIn[]
}

/// 스태프 ↔ 행사 배정. 배정이 지워지면 다음 요청부터 그 행사에 접근할 수 없다
model DropStaff {
  dropId    String
  staffId   String
  createdAt DateTime @default(now())
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([dropId, staffId])
  @@index([staffId])
}

/// 로그인용 6자리 코드. 원문은 저장하지 않고 해시만 둔다
model StaffLoginCode {
  id        String    @id @default(cuid())
  staffId   String
  codeHash  String
  expiresAt DateTime
  /// 틀린 횟수. 한도를 넘으면 그 코드는 더 이상 쓸 수 없다
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
}

/// 앱 로그인 세션. 토큰 원문은 앱에만 있고 서버에는 해시만 둔다
model StaffSession {
  id        String   @id @default(cuid())
  staffId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

enum DropType {
  ticket
  goods
}

enum DropMediaType {
  image
  video
}

enum OrderStatus {
  pending
  paid
  confirmed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum BankTransferStatus {
  pending
  confirmed
  expired
  cancelled
}

enum TicketStatus {
  active
  checked_in
  cancelled
}

enum CheckInKind {
  entry
  undo
}

/// 오프라인 입장을 동기화해 보니 들여보내면 안 됐던 경우. 이미 입장한 사람이라
/// 되돌릴 수는 없고, 주최자가 사후에 확인할 수 있게 표시만 한다
enum CheckInFlag {
  /// 재입장 불가 행사에서 이미 입장 처리된 티켓이 또 입장 (다른 입구와 겹침 등)
  duplicate
  /// 목록을 받은 뒤 취소·환불된 티켓으로 입장
  cancelled_ticket
}
