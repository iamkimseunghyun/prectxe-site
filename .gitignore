# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (워크스페이스마다 생기므로 루트 고정하지 않는다)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# turborepo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp logs/screenshots
.playwright-mcp/

# temporary screenshots
*.png

# serena memories (regenerated per machine)
.serena/

# local scratch / throwaway experiments
scratchtest/
